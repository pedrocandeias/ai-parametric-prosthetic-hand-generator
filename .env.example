# Copy this file to .env and fill in real values
# NEVER commit .env to version control

# Required: JWT secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-me-to-a-random-256-bit-secret

# AI Provider API Keys (server-side only — never expose these to clients)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Server
PORT=3000
NODE_ENV=development

# Email / SMTP (optional — leave blank to disable outgoing email).
# When unset, registration verification and password-reset emails are skipped
# (the app keeps working; tokens can still be issued manually by an admin).
# For cPanel: SMTP_HOST=mail.yourdomain.com, a no-reply mailbox as USER/PASS.
# For a provider (Resend/SendGrid/Postmark): use their SMTP host + credentials.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hand Fab <no-reply@example.com>"

# Public base URL used to build links in emails (no trailing slash).
# Falls back to the request origin if unset.
APP_BASE_URL=https://handfab.pedrocandeias.net

# Optional: require email verification before login (default: false).
# New self-service registrations always receive a verification email regardless;
# this flag controls whether unverified users are blocked from logging in.
REQUIRE_EMAIL_VERIFICATION=false
