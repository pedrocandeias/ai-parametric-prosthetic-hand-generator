/* ---- geometry helpers --------------------------------------------- */
function unit_vec(v) = v/norm(v);
CX = 0.5*(AP[2][0].x + AP[2][len(AP[2])-1].x);                 // arch centre x (SPAN_GAIN pivot)
// Apply SPAN_GAIN (widen/narrow about CX) and APEX_GAIN (scale height) to a 2D pt.
function shaped(p) = [ CX + (p.x-CX)*SPAN_GAIN, p.y*APEX_GAIN ];

// Inner cavity wall = outer arch pushed inward by WALL (skip the 2 feet so the
// bottom stays open). For each interior vertex: estimate the local tangent from
// its neighbours, take the perpendicular, flip it to point OUTWARD (away from the
// arch centre [CX, base_z]), then move the vertex inward by WALL along that normal.
function inner_arch(arch) = let(
    base_z = min([for(p=arch) shaped(p).y]) )
  [ for(i=[1:len(arch)-2])
      let( prev    = shaped(arch[max(i-1,1)]),
           next    = shaped(arch[min(i+1,len(arch)-2)]),
           tangent = unit_vec(next-prev),
           normal  = [tangent.y, -tangent.x],
           vtx     = shaped(arch[i]),
           out_normal = (normal*(vtx-[CX,base_z]) >= 0) ? normal : -normal )
      vtx - WALL*out_normal ];

// Outer arch of station i lifted into 3D: (X, AY[i], Z).
function out3d(i) = [ for(p=AP[i]) let(sp=shaped(p)) [sp.x, AY[i], sp.y] ];
// Inner arch of station i in 3D, closed below z=-10 (the 2 trailing points) so the
// cavity-subtraction solid is capped well under the plate -> clean open bottom.
function in3d(i)  = let( inner = inner_arch(AP[i]) )
    concat( [for(p=inner) [p.x, AY[i], p.y]],
            [ [inner[len(inner)-1].x, AY[i], -10], [inner[0].x, AY[i], -10] ] );

/* ---- the module --------------------------------------------------- */
module dorsal_shell() {
    difference() {
        skin([for(i=[0:len(AY)-1]) out3d(i)], slices=0, caps=true);   // solid arch dome
        skin([for(i=[0:len(AY)-1]) in3d(i)],  slices=0, caps=true);   // hollow it (open bottom)
        for (channel = CH) path_sweep(circle(r=CH_R), channel);       // cable channels
    }
}
