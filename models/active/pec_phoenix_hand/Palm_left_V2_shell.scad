  [[-22.9,-32,24.5],[-22.9,-29,25.3],[-25.0,-12,25.8],[-26.6,-1,24.7],[-27.7,12,20.8],[-28.7,20,16.7],[-29.2,23,15.2],[-29.4,26.5,14.8]],  // ch1 pinky (wrist->finger cap)
  [[-15.3,-32,25.8],[-15.3,-30,25.8],[-15.2,-12,27.1],[-15.0,0,26.5],[-15.0,12,24.4],[-14.9,20,21.9],[-14.9,24,20.0],[-14.9,26.5,19.9]],     // ch2 ring
  [[ -7.5,-32,26.0],[ -7.5,-29,27.1],[ -5.6,-12,27.5],[ -4.3,0,27.2],[ -2.9,12,26.3],[ -2.0,20,24.8],[ -1.6,24,22.6],[ -1.5,26.5,22.4]],     // ch3 middle
