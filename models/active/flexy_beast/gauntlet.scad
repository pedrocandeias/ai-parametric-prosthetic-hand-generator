// ============================================================
// Forearm gauntlet (Normal Gauntlet with Tensioner) — self-contained.
// Organic shell embedded as a decimated polyhedron (gauntlet_shell_mesh,
// ~8000 faces, 99% of the original volume); mechanical holes re-cut
// parametrically. No STL import. Measured from the original mesh (mm).
//
// Usage:  gauntlet();                       // defaults
//         gauntlet(rim_hole_d = 3.5);       // wider strap holes
// Hole params are MODULE ARGUMENTS (not globals) so an including file's
// own variables never clash with these.
// ============================================================

// Measured hole placements (gauntlet's own coordinate frame, mm)
G_MID_HOLES = [ [ 12.6, 8.5, 11.5], [-12.6, 8.5, 11.5] ];   // axis +Z
G_PIN_HOLES = [ [ 22.6,-58.3,-9.8], [-22.6,-58.3,-9.8] ];   // axis +X
G_RIM_HOLES = [ [-11.32,42.78,18.44], [-5.31,42.60,20.36], [0.85,42.61,21.15],
                [ 6.76,42.86,20.40], [12.18,43.31,18.23] ];
G_RIM_AXIS  = [-0.021, 0.988, 0.156];
G_MID_WALL  = 3.2;  G_PIN_WALL = 5.0;  G_RIM_WALL = 5.0;

// Full gauntlet: embedded shell + parametric holes.
//   recut     : plug the originals and redrill (mid/pin editable both ways)
//   *_hole_d  : hole diameters. rim holes are recut-only (enlarge >= ~2.5 only).
module gauntlet(mid_hole_d = 3.5, pin_hole_d = 5.0, rim_hole_d = 2.5,
                recut = true, fn = 32) {
    $fn = fn;
    difference() {
        union() {
            gauntlet_shell_mesh();
            if (recut) {
                for (p = G_MID_HOLES) translate(p)
                    cylinder(d = mid_hole_d + 0.2, h = G_MID_WALL + 1.5, center = true);
                for (p = G_PIN_HOLES) translate(p) rotate([0,90,0])
                    cylinder(d = pin_hole_d + 0.2, h = G_PIN_WALL + 1.5, center = true);
                // rim holes: recut-only (small tilted holes through a curved thick band)
            }
        }
        if (recut) {
            for (p = G_MID_HOLES) translate(p)
                cylinder(d = mid_hole_d, h = 30, center = true);
            for (p = G_PIN_HOLES) translate(p) rotate([0,90,0])
                cylinder(d = pin_hole_d, h = 24, center = true);
            for (p = G_RIM_HOLES) g_drill(p, G_RIM_AXIS)
                cylinder(d = rim_hole_d, h = G_RIM_WALL + 10, center = true);
        }
    }
}

// Orient +Z of children to unit vector v, at point p
module g_drill(p, v) {
    translate(p) rotate([0,0,atan2(v.y,v.x)]) rotate([0,acos(v.z),0]) children();
}

