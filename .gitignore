# API Configuration (contains sensitive keys — deprecated, use .env)
config.json

# Environment variables (contain API keys and secrets)
.env

# SQLite database (keep datasets & generator scripts under data/ tracked)
data/app.db
data/app.db-*
data/app.db.bak-*
data/*.db
data/*.db-shm
data/*.db-wal
data/.~lock.*

# Node modules
node_modules/
Hand Fab prosthetic configurator/
models/old_models/*

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*

# Deployment staging output (produced by ./deploy.sh collect)
deploy/
deploy.tar.gz

# FTP deploy credentials + local upload manifests (./deploy.sh ftp)
.ftp-deploy.conf
.deploy-state/

# Slicer scratch (binaries + gcode output)
.slicer-work/

# Release delta archives (built locally, never committed)
dist-*.zip

# Thesis evaluation evidence (large STL/screenshot/trace artefacts + campaign
# metadata). Preserved locally and selectively copied to the dissertation annex;
# never committed to the code repo.
test-results/

# Scratch / in-progress model build artifacts (never commit or deploy)
**/_assembly.*
**/*_preview.png
**/assemblage-*.jpg
models/**/output/
models/**/previews/
models/**/stls/
